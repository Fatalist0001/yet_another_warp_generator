# --- Чувствительные данные инструмента ---

# Эталонные WARP-конфиги: содержат приватные ключи
refconf/

# Любые сгенерированные конфиги AmneziaWG: содержат приватный ключ клиента
*.conf
gen-*.conf

# Аккаунт WARP (приватный ключ + токены) — хранится локально, не в репозитории
test-account.json
warpgen-account.json
*-account.json

# Каталоги цепочки `warpgen chain` и e2e-прогонов `warpgen run`:
# identity warp-plus (приватный ключ) и кэш Psiphon
warpgen-chain/
warpgen-e2e/

# --- Локальные документы, не для репозитория ---

# Отчёты о тестах, инструкция и экспорт чата
# (уже отслеживаемые ранее файлы сняты с отслеживания — они остаются только локально)
docs/*.md

# --- Артефакты сборки и тестов ---

/warpgen
/warpgen-debug
coverage.out

# Релизный бинарник warp-plus (20 МБ), который warpgen ищет рядом с собой
/warp-plus

# --- GUI (Flutter) ---
# Локальный SDK Flutter (ставится в корень проекта, чтобы не занимать основной диск)
/.toolchain/

# Артефакты сборки Flutter-приложения
/gui/build/
/gui/.dart_tool/
/gui/.flutter-plugins
/gui/.flutter-plugins-dependencies
/gui/linux/flutter/ephemeral/

# AppImage GUI и рабочие каталоги его сборки
/warpgen-*-x86_64.AppImage
/.appimage-build/

# Инструменты AppImage (сторонние бинарники, скачиваются вручную)
/appimagetool.AppImage
/linuxdeploy.AppImage
/linuxdeploy-plugin-gtk.sh

# --- ОС и редакторы ---
.DS_Store
*.swp

start.txt
